{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrs-upgrade/customizations-scan.schema.json",
  "title": "jrs-upgrade customizations scan --json (spec §10.3, #72)",
  "type": "object",
  "additionalProperties": false,
  "required": ["installedWebapp", "vendorWebapp", "entries", "registered"],
  "properties": {
    "installedWebapp": { "type": "string" },
    "vendorWebapp": { "type": "string", "description": "The vendor directory or war compared against." },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change", "registered"],
        "properties": {
          "path": { "type": "string", "description": "Relative to the webapp, with / separators." },
          "change": { "enum": ["CHANGED", "ADDED", "INSTALLER", "REMOVED"] },
          "registered": { "type": "boolean" }
        }
      }
    },
    "tomcat": {
      "type": "array",
      "description": "Present with --tomcat: the Tomcat-side files to carry over (issue #117).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "registered"],
        "properties": {
          "path": { "type": "string", "description": "Relative to server.tomcatDir, with / separators." },
          "kind": { "enum": ["SETENV", "SERVER_XML", "CONTEXT_FRAGMENT", "LIBRARY"] },
          "registered": { "type": "boolean" }
        }
      }
    },
    "findings": {
      "type": "object",
      "description": "Present with --target: what becomes of the changed and added files on the target version (ADR-0003).",
      "additionalProperties": false,
      "required": ["targetWebapp", "sourceVersion", "targetVersion", "jars", "classes", "jakarta"],
      "properties": {
        "targetWebapp": { "type": "string" },
        "sourceVersion": { "type": "string" },
        "targetVersion": { "type": "string" },
        "jars": {
          "type": "array",
          "description": "Issue #4: one verdict per jar under WEB-INF/lib the vendor copy lacks or the site patched.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["jar", "verdict", "reason"],
            "properties": {
              "jar": { "type": "string" },
              "coordinates": { "type": "string", "description": "groupId:artifactId:version, or artifactId:version from the file name." },
              "verdict": { "enum": ["DROP", "KEEP", "REPLACE", "REVIEW", "UNRESOLVED"] },
              "targetJar": { "type": "string", "description": "The target's jar of the same artifact." },
              "reason": { "type": "string" }
            }
          }
        },
        "classes": {
          "type": "array",
          "description": "Issue #5: the vendor types the site's jars and WEB-INF/classes refer to, and where the target has them.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["jar", "vendorType", "usedBy", "status", "detail"],
            "properties": {
              "jar": { "type": "string", "description": "A jar's file name, or WEB-INF/classes." },
              "vendorType": { "type": "string" },
              "usedBy": { "type": "string", "description": "How the site's code uses it: extended, implemented or used, and by which class." },
              "status": { "enum": ["PRESENT", "MOVED", "MISSING", "UNREADABLE"] },
              "detail": { "type": "string" }
            }
          }
        },
        "jakarta": {
          "type": "array",
          "description": "Issue #5: for a 10.0 or later target, the site jars that refer to javax packages Jakarta EE 10 renamed and need a recompile.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["jar", "javaxReferences"],
            "properties": {
              "jar": { "type": "string" },
              "javaxReferences": { "type": "object", "additionalProperties": { "type": "integer" } }
            }
          }
        }
      }
    },
    "registered": {
      "type": "array",
      "description": "Customizations registered by this run (--register).",
      "items": { "$ref": "https://jaspersoft.com/jrs-upgrade/customization.schema.json" }
    }
  }
}
