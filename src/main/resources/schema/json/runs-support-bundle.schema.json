{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrs-upgrade/runs-support-bundle.schema.json",
  "title": "jrs-upgrade runs support-bundle <id> --json: where the bundle was written and what it holds",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "path", "entries", "bytes"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "bytes": { "type": "integer", "minimum": 1 }
  }
}
